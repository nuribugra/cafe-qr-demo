# Persistent menu storage (Upstash Redis) — required in every environment,
# including local dev. The whole menu is stored as one JSON value in Redis
# so it survives redeploys on Vercel (whose filesystem is read-only/ephemeral
# at runtime).
#
# Get these two values by either:
#   1. Creating a free database at https://upstash.com and copying its
#      "REST URL" and "REST Token" from the database's dashboard, or
#   2. Adding the "Upstash for Redis" integration from the Vercel Marketplace
#      to this project — it provisions the database and injects the env vars
#      for you automatically (run `vercel env pull .env.local` to get them
#      locally). That integration may name them KV_REST_API_URL /
#      KV_REST_API_TOKEN instead — the app accepts either naming, so just
#      leave whichever pair Vercel added and skip the other.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin authentication — required in every environment. Neither of these has
# a working default; the app fails closed (admin login refuses to work) if
# either is missing, rather than falling back to something insecure.
#
# 1. Choose a real admin password and hash it (the plaintext never leaves
#    your machine or gets committed anywhere):
#      node scripts/hash-password.mjs "your-chosen-password"
#    The script prints two versions — paste the "in a .env file" one here
#    (Next.js expands unescaped $ characters in .env files, which a bcrypt
#    hash is full of; the Vercel dashboard doesn't do this, so use the
#    script's other, unescaped version when pasting there instead).
ADMIN_PASSWORD_HASH=
#
# 2. Generate a random secret used to sign admin session cookies:
#      node scripts/generate-session-secret.mjs
ADMIN_SESSION_SECRET=
